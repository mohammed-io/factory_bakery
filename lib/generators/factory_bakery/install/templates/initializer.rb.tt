# frozen_string_literal: true
<% if @seed_framework -%>

# Generated values follow the test framework's seed (`rspec --seed N` or
# `bin/rails test --seed N`). See docs/guide/configuration.md#randomness.
require 'factory_bakery/<%= @seed_framework %>'
<% end -%>

Rails.application.config.factory_bakery.tap do |config|
  # config.associations = :required_only
<% if @bakery_directory -%>
  config.definition_paths = <%= [@bakery_directory].inspect %>
<% else -%>
  # config.definition_paths = ['custom/factories']
<% end -%>
  # config.fill_optional = true
  # config.validate = false # skip the gem's own checks (like FactoryBot.build)
  # config.savepoints = true # roll back what a failed bake! or a discarded fallback attempt wrote
  # config.generators = false
end
